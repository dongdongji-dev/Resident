# 环境变量模板：实际值写在同目录 .env（已被 .gitignore 忽略，不会上传）。
# 首次启动 console 时若没有 .env，会用本文件生成一份，并自动生成
# RESIDENT_API_KEY / RESIDENT_CONSOLE_TOKEN 两个强随机值（写入 .env 并
# 打印在启动日志里）；其余变量（LLM_* 等）仍需手动填写。
# 注意：下面所有变量都必须存在（即使对应功能在配置里是关闭的）——
# config/*.yaml 里的 ${VAR} 在启动时统一展开，缺任何一个都会启动失败。

# ── LLM（主模型）──
LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
LLM_API_KEY=changeme
LLM_MODEL=your-model-name

# ── LLM（独立压缩模型，可选）──
# config/agent.yaml 的 compression.llm.enabled: true 时使用（记忆提取+摘要）；
# 关闭时压缩回退主模型，但这些变量仍必须存在。
LLM_COMPRESS_BASE_URL=https://your-llm-endpoint.example.com/v1
LLM_COMPRESS_API_KEY=changeme
LLM_COMPRESS_MODEL=your-model-name

# ── 鉴权（两层，务必改成强随机值）──
# 第一层：kernel HTTP / 事件端口
RESIDENT_API_KEY=changeme
# 第二层：console / 前端登录
RESIDENT_CONSOLE_TOKEN=changeme

# ── kernel 入口解释器（安装脚本按平台自动写入；正常无需手改）──
# Unix host 与 Docker 部署均为 .venv/bin/python；Windows host 模式为 .venv\Scripts\python.exe
RESIDENT_PYTHON=.venv/bin/python

# ── 图床（imgbed.enabled: true 时使用）──
IMGBED_API_KEY=changeme

# ── 邮箱逃生通道（email.enabled: true 时使用；QQ 邮箱为授权码）──
EMAIL_IMAP_PASSWORD=changeme
EMAIL_SMTP_PASSWORD=changeme

# ── 中国大陆网络加速（可选；install 脚本自动探测/写入）──
# 影响 pip / npm 与 Docker 构建内的 apt；Docker 镜像一律走官方源，
# 到不了 Docker Hub 时配置代理（见安装文档「代理」章节）。
# RESIDENT_NPM_REGISTRY=https://registry.npmmirror.com
# RESIDENT_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# RESIDENT_APT_MIRROR=mirrors.aliyun.com

# ── 控制台监听（Docker 部署用；安装脚本会询问并写入）──
# 0.0.0.0 = 局域网可访问；127.0.0.1 = 仅本机（host 模式此值无效，见 config/console.yaml）
# RESIDENT_CONSOLE_BIND=127.0.0.1

# ── 镜像来源（可选；Docker 部署）──
# 发布官方镜像后填 registry 镜像名；部署优先拉取（拉不到再本地构建）。
# RESIDENT_APP_IMAGE=ghcr.io/<owner>/resident-app:latest
# RESIDENT_SANDBOX_IMAGE=ghcr.io/<owner>/resident-sandbox:latest
